{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!.vitepress/cache",
			"!assets",
			"!.archive",
			"!src/renderers/utils/pathUtils.ts",
			"!electrobun.config.ts"
		]
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"linter": {
		"rules": {
			"suspicious": {
				"noExplicitAny": "off",
				"useIterableCallbackReturn": "off"
			},
			"style": {
				"useNamingConvention": "off",
				"noNonNullAssertion": "off"
			},
			"a11y": {
				"useSemanticElements": "off"
			},
			"complexity": {
				"noBannedTypes": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"src/renderers/ivde/**",
				"apps/colab-renderer/src/components/AppShell.tsx",
				"apps/renderer/src/components/AppShell.tsx"
			],
			"linter": {
				"rules": {
					"a11y": {
						"noStaticElementInteractions": "off",
						"useKeyWithClickEvents": "off",
						"useKeyWithMouseEvents": "off",
						"noSvgWithoutTitle": "off",
						"useButtonType": "off",
						"useValidAnchor": "off",
						"noLabelWithoutControl": "off"
					},
					"suspicious": {
						"noControlCharactersInRegex": "off",
						"noAssignInExpressions": "off",
						"noShorthandPropertyOverrides": "off",
						"noNonNullAssertedOptionalChain": "off",
						"noImplicitAnyLet": "off"
					},
					"complexity": {
						"noCommaOperator": "off"
					},
					"style": {
						"useConst": "off"
					},
					"correctness": {
						"noUnusedFunctionParameters": "warn",
						"noConstantCondition": "warn"
					}
				}
			}
		},
		{
			"includes": [
				"tests/**",
				"scripts/**"
			],
			"linter": {
				"rules": {
					"suspicious": {
						"noAssignInExpressions": "off",
						"noImplicitAnyLet": "off"
					},
					"a11y": {
						"useFocusableInteractive": "off"
					},
					"correctness": {
						"noInvalidUseBeforeDeclaration": "off"
					}
				}
			}
		},
		{
			"includes": [
				"webflow-plugin/**"
			],
			"linter": {
				"rules": {
					"a11y": {
						"noStaticElementInteractions": "off",
						"useKeyWithClickEvents": "off",
						"noLabelWithoutControl": "off"
					}
				}
			}
		},
		{
			"includes": [
				"docs/**"
			],
			"linter": {
				"rules": {
					"a11y": {
						"noSvgWithoutTitle": "off"
					},
					"correctness": {
						"noInvalidPositionAtImportRule": "off"
					}
				}
			}
		},
		{
			"includes": [
				"electrobun.config.ts",
				"packages/**"
			],
			"linter": {
				"rules": {
					"complexity": {
						"noUselessLoneBlockStatements": "off"
					},
					"suspicious": {
						"noConfusingLabels": "off",
						"noDocumentCookie": "off"
					}
				}
			}
		},
		{
			"includes": [
				"src/main/**"
			],
			"linter": {
				"rules": {
					"suspicious": {
						"noImplicitAnyLet": "off",
						"noAssignInExpressions": "off",
						"noControlCharactersInRegex": "off"
					}
				}
			}
		}
	]
}
