{
	"$schema": "https://biomejs.dev/schemas/2.0.0/schema.json",
	"root": false,
	"files": {
		"includes": [
			"**",
			"!**/node_modules/**",
			"!**/docs/.vitepress/dist/**",
			"!**/docs/.generated/**",
			"!**/.worktrees/**",
			"!**/kitty-specs/**",
			"!**/docs/sessions/**"
		]
	},
	"formatter": {
		"enabled": true,
		"lineWidth": 100,
		"indentStyle": "space",
		"indentWidth": 2
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedImports": "error",
				"useImportExtensions": "off"
			},
			"style": {
				"useNamingConvention": "off",
				"noDefaultExport": "off",
				"useFilenamingConvention": "off",
				"useBlockStatements": "off"
			},
			"suspicious": {
				"noConsole": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"arrowParentheses": "asNeeded",
			"bracketSameLine": false,
			"bracketSpacing": true,
			"jsxQuoteStyle": "double",
			"quoteProperties": "asNeeded",
			"semicolons": "always",
			"trailingCommas": "es5"
		}
	},
	"overrides": [
		{
			"includes": ["**/apps/desktop/src/runtime_client.ts"],
			"linter": {
				"rules": {
					"style": {
						"useNamingConvention": "off"
					}
				}
			}
		}
	],
	"json": {
		"formatter": {
			"trailingCommas": "none"
		}
	}
}
