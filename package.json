{
  "name": "helioslab",
  "version": "2026.05B.0",
  "private": true,
  "description": "Independent Helios developer runtime, desktop shell, and research lab",
  "workspaces": [
    "apps/runtime",
    "apps/desktop",
    "apps/colab-renderer",
    "packages/errors",
    "packages/ids",
    "packages/logger",
    "packages/runtime-core",
    "packages/types",
    "webflow-plugin",
    "test-plugin"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/desktop dev",
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "dev:runtime": "bun run --cwd apps/runtime dev",
    "dev:colab": "bun run --cwd apps/colab-renderer dev",
    "dev:legacy-lab": "bun run scripts/setup-deps.ts && electrobun dev",
    "start": "bun run --cwd apps/desktop dev",
    "app": "bun run --cwd apps/desktop dev",
    "build": "bun run build:helios && bun run build:rust",
    "build:helios": "bun run --cwd apps/desktop build && bun run --cwd apps/runtime build && bun run --cwd apps/colab-renderer build",
    "build:legacy-lab": "bun run scripts/setup-deps.ts && electrobun build --env=stable",
    "build:rust": "cargo build --workspace --exclude pheno-ffi-python",
    "typecheck": "tsc --noEmit",
    "typecheck:rust": "cargo check --workspace --exclude pheno-ffi-python --all-targets",
    "typecheck:all": "bun run typecheck && bun run typecheck:rust",
    "lint": "oxlint --deny-warnings apps packages src scripts tests",
    "lint:rust": "cargo clippy --workspace --exclude pheno-ffi-python --all-targets -- -D warnings",
    "lint:all": "bun run lint && bun run lint:rust && cargo fmt --all -- --check",
    "format": "biome format --write apps docs/.vitepress playwright.config.ts tsconfig.json package.json",
    "test": "bun test apps packages scripts tests docs/tests/unit docs/tests/component tools/gates",
    "test:desktop": "bun test apps/desktop/tests/unit",
    "test:integration": "bun test --timeout 60000 apps/runtime/tests/integration",
    "test:e2e": "playwright test",
    "test:rust": "cargo test --workspace --exclude pheno-ffi-python",
    "test:all": "bun run test && bun run test:rust",
    "test:coverage": "bun test --coverage apps packages scripts tests",
    "security:scan": "bun run scripts/gate-security.ts",
    "traceability": "bun tools/gates/requirement-traceability.mjs",
    "gates": "bun run typecheck:all && bun run lint:all && bun run test:all && bun run traceability",
    "docs:index": "bash docs/scripts/generate-doc-index.sh",
    "docs:dev": "vitepress dev docs",
    "docs:build": "bun run docs:index && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "deps:status": "bun scripts/deps-status.ts",
    "deps:rollback": "bun scripts/deps-rollback.ts",
    "deps:canary": "bun scripts/deps-canary.ts",
    "deps:log": "bun scripts/deps-canary.ts log"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@webflow/webflow-cli": "^1.1.1",
    "ansi-to-html": "^0.7.2",
    "date-fns": "4.1.0",
    "electrobun": "1.18.1",
    "esbuild-monaco-editor-plugin": "^0.1.1",
    "fs-extra": "^11.2.0",
    "goldfishdb": "^0.1.3",
    "ky": "2.0.2",
    "mixpanel": "^0.18.0",
    "monaco-editor": "0.52.0",
    "pino": "10.3.1",
    "simple-git": "^3.22.0",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@biomejs/biome": "2.4.13",
    "@playwright/test": "1.59.1",
    "@types/node": "25.6.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "bun-types": "1.3.14",
    "esbuild": "^0.28.0",
    "esbuild-plugin-solid": "^0.6.0",
    "happy-dom": "20.9.0",
    "oxlint": "1.62.0",
    "typescript": "6.0.3",
    "vitepress": "1.6.4",
    "vitest": "4.1.5"
  },
  "engines": {
    "bun": ">=1.2.20",
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.2.20"
}
